{
  "name": "@icazemier/sway",
  "private": false,
  "version": "2.1.1",
  "type": "module",
  "description": "Adaptive concurrent task runner — like Promise.all() with gradient-based concurrency control",
  "contributors": [
    {
      "name": "Ivo Cazemier",
      "email": "git@warmemelk.nl",
      "url": "https://github.com/icazemier"
    }
  ],
  "keywords": [
    "concurrency",
    "async",
    "promise",
    "parallel",
    "adaptive",
    "throttle",
    "task runner"
  ],
  "files": [
    "build/"
  ],
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "exports": {
    ".": {
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  },
  "types": "./build/esm/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "test": "vitest run --coverage",
    "build:esm": "tsc -p tsconfig-build-esm.json",
    "build:cjs": "tsc -p tsconfig-build-cjs.json",
    "build": "npm run clean:build && npm run build:esm && npm run build:cjs && npm run fixup && npm run docs",
    "docs": "npm run clean:docs && typedoc --out docs src/index.ts",
    "fixup": "node ./fixup.mjs",
    "benchmark": "vitest bench",
    "clean:build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "clean:docs": "node -e \"require('fs').rmSync('docs',{recursive:true,force:true})\"",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "changeset": "changeset",
    "pre-mode": "node ./pre-mode.mjs",
    "release:version": "npm run pre-mode && changeset version && npm install --package-lock-only",
    "release": "npm run pre-mode && changeset publish",
    "publish:jsr": "jsr publish --allow-dirty"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icazemier/sway.git"
  },
  "homepage": "https://github.com/icazemier/sway#readme",
  "bugs": {
    "url": "https://github.com/icazemier/sway/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.15",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsr": "0.14.3",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
